---
import { getEntry } from "astro:content";
import Layout from "./Layout.astro";
import SocialLinks from "../components/SocialLinks.astro";

interface Props {
  title: string;
  description?: string;
  heading?: string;
}

const siteEntry = await getEntry("site", "site-settings");

if (!siteEntry) {
  throw new Error("Site settings could not be loaded.");
}

const site = siteEntry.data;

const {
  title,
  description = site.description,
  heading = title,
} = Astro.props;

const navigation = site.navigation;
const currentPath = Astro.url.pathname;
---

<Layout title={title} description={description}>
  <div class="page">
    <header class="site-header">
      <a class="site-name" href="/">{site.name}</a>

      <nav aria-label="Primary navigation">
        <ul>
          {
            navigation.map(({ label, href }) => {
              const isCurrent =
                href === "/"
                  ? currentPath === "/"
                  : currentPath.startsWith(href);

              return (
                <li>
                  <a
                    href={href}
                    aria-current={isCurrent ? "page" : undefined}
                  >
                    {label}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>
    </header>

    <main class="page-content">
      <header class="page-heading">
        <p class="eyebrow">{description}</p>
        <h1>{heading}</h1>
      </header>

      <div class="content">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
        <div class="footer-left">
            <p>&copy; {new Date().getFullYear()} {site.name}</p>
        </div>

        <div class="footer-right">
            <SocialLinks />
        </div>
    </footer>
  </div>
</Layout>

<style>
  .page {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    background:
      radial-gradient(
        circle at 15% 20%,
        rgba(255, 255, 255, 0.08) 0 1px,
        transparent 1.5px
      ),
      radial-gradient(
        circle at 75% 35%,
        rgba(255, 255, 255, 0.05) 0 1px,
        transparent 1.5px
      ),
      radial-gradient(
        circle at 45% 80%,
        rgba(255, 255, 255, 0.07) 0 1px,
        transparent 1.5px
      ),
      #050505;
    background-size:
      11rem 11rem,
      17rem 17rem,
      23rem 23rem;
  }

  .page::before {
    position: fixed;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(
        circle at 50% 0%,
        rgba(55, 75, 115, 0.2),
        transparent 45%
      );
    content: "";
    pointer-events: none;
  }

  .site-header,
  .page-content,
  .site-footer {
    position: relative;
    z-index: 1;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(100% - 3rem, 78rem);
    margin-inline: auto;
    padding-block: 2rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }

  .site-name {
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    position: relative;
    color: rgba(255, 255, 255, 0.68);
    font-size: 0.82rem;
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 180ms ease;
  }

  nav a:hover,
  nav a:focus-visible,
  nav a[aria-current="page"] {
    color: #ffffff;
  }

  nav a[aria-current="page"]::after {
    position: absolute;
    right: 0;
    bottom: -0.45rem;
    left: 0;
    height: 1px;
    background: currentColor;
    content: "";
  }

  .page-content {
    width: min(100% - 3rem, 64rem);
    margin-inline: auto;
    padding-block: clamp(5rem, 10vw, 9rem);
  }

  .page-heading {
    margin-bottom: clamp(3rem, 7vw, 5rem);
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 12ch;
    margin: 0;
    font-size: clamp(3.5rem, 10vw, 8rem);
    font-weight: 700;
    line-height: 0.88;
    letter-spacing: -0.06em;
  }

  .content {
    max-width: 48rem;
    color: rgba(255, 255, 255, 0.78);
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    line-height: 1.8;
  }

  .content :global(h2) {
    margin: 4rem 0 1.25rem;
    color: #ffffff;
    font-size: clamp(1.7rem, 4vw, 2.5rem);
    line-height: 1.15;
    letter-spacing: -0.035em;
  }

  .content :global(h3) {
    margin: 2.5rem 0 1rem;
    color: #ffffff;
    font-size: 1.3rem;
  }

  .content :global(p) {
    margin: 0 0 1.5rem;
  }

  .content :global(a) {
    color: #ffffff;
    text-decoration-color: rgba(255, 255, 255, 0.4);
    text-underline-offset: 0.25rem;
  }

  .content :global(a:hover) {
    text-decoration-color: #ffffff;
  }

  .content :global(ul),
  .content :global(ol) {
    padding-left: 1.5rem;
  }

  .content :global(li) {
    margin-bottom: 0.6rem;
  }

  .site-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;

    width: min(100% - 3rem, 78rem);
    margin-inline: auto;
    padding-block: 2rem;

    border-top: 1px solid rgba(255, 255, 255, 0.14);

    color: rgba(255, 255, 255, 0.55);
    font-size: 0.8rem;
    }

    .footer-left p {
    margin: 0;
    }

    .footer-right {
    display: flex;
    align-items: center;
    }

  @media (max-width: 800px) {
    .site-header {
      align-items: flex-start;
      flex-direction: column;
      gap: 1.5rem;
    }

    nav ul {
      gap: 0.75rem 1rem;
    }
  }

  @media (max-width: 520px) {
    .site-header,
    .page-content,
    .site-footer {
      width: min(100% - 2rem, 78rem);
    }

    .page-content {
      padding-block: 4rem;
    }

    .site-footer {
        flex-direction: column;
        gap: 1.25rem;
        text-align: center;
    }

    .footer-left,
    .footer-center,
    .footer-right {
        justify-self: center;
    }
  }
</style>