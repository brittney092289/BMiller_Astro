---
import PageLayout from "../../layouts/PageLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const talks = await getCollection("talks");

  return talks.map((talk) => ({
    params: {
      id: talk.id,
    },

    props: {
      talk,
    },
  }));
}

const { talk } = Astro.props;
const { Content } = await render(talk);

const formattedDate = talk.data.date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

function formatDuration(minutes = 0) {
  if (minutes < 60) {
    return `${minutes} minutes`;
  }

  const hours = Math.floor(minutes / 60);
  const remainingMinutes = minutes % 60;

  if (remainingMinutes === 0) {
    return `${hours} ${hours === 1 ? "hour" : "hours"}`;
  }

  return `${hours} ${hours === 1 ? "hour" : "hours"} ${remainingMinutes} minutes`;
}

const hasMetadata =
  talk.data.event ||
  talk.data.location ||
  talk.data.audience ||
  talk.data.duration !== undefined ||
  talk.data.attendance !== undefined;
---

<PageLayout
  title={talk.data.title}
  description={talk.data.summary}
>
  <section class="section section-alt">
    <div class="container presentation-container">
      <header class="presentation-header">
        <p class="presentation-date">
          <time datetime={talk.data.date.toISOString()}>
            {formattedDate}
          </time>
        </p>

        <h1>{talk.data.title}</h1>

        <p class="presentation-venue">
          {talk.data.venue}

          {
            talk.data.location && (
              <>
                <span aria-hidden="true"> · </span>
                {talk.data.location}
              </>
            )
          }
        </p>

        <p class="presentation-summary">
          {talk.data.summary}
        </p>

        {
          hasMetadata && (
            <dl class="presentation-details">
              {
                talk.data.event && (
                  <div>
                    <dt>Event</dt>
                    <dd>{talk.data.event}</dd>
                  </div>
                )
              }

              {
                talk.data.audience && (
                  <div>
                    <dt>Audience</dt>
                    <dd>{talk.data.audience}</dd>
                  </div>
                )
              }

              {
                talk.data.duration !== undefined && (
                  <div>
                    <dt>Length</dt>
                    <dd>{formatDuration(talk.data.duration)}</dd>
                  </div>
                )
              }

              {
                talk.data.attendance !== undefined && (
                  <div>
                    <dt>Attendance</dt>
                    <dd>
                      {talk.data.attendance.toLocaleString("en-US")}
                    </dd>
                  </div>
                )
              }
            </dl>
          )
        }

        {
          (talk.data.slides || talk.data.recording) && (
            <div class="presentation-links">
              {
                talk.data.slides && (
                  <a
                    class="presentation-button"
                    href={talk.data.slides}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    View slides
                  </a>
                )
              }

              {
                talk.data.recording && (
                  <a
                    class="presentation-button"
                    href={talk.data.recording}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Watch recording
                  </a>
                )
              }
            </div>
          )
        }
      </header>

      <article class="presentation-content">
        <Content />
      </article>
    </div>
  </section>
</PageLayout>

<style>
  .presentation-container {
    max-width: 900px;
  }

  .presentation-header {
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border-color);
  }

  .presentation-date {
    margin: 0 0 0.75rem;
    color: var(--text-muted);
  }

  .presentation-header h1 {
    margin: 0;
  }

  .presentation-venue {
    margin: 0.85rem 0 0;
    color: var(--text-muted);
    font-size: 1.05rem;
  }

  .presentation-summary {
    max-width: 70ch;
    margin: 1.25rem 0 0;
    font-size: 1.1rem;
    line-height: 1.7;
  }

  .presentation-details {
    display: grid;
    grid-template-columns: repeat(
      auto-fit,
      minmax(140px, 1fr)
    );
    gap: 1rem;
    margin: 2rem 0 0;
  }

  .presentation-details div {
    padding: 1rem;
    border: 1px solid var(--border-color);
    border-radius: 0.7rem;
    background: rgba(255, 255, 255, 0.04);
  }

  .presentation-details dt {
    color: var(--text-muted);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .presentation-details dd {
    margin: 0.35rem 0 0;
    font-weight: 600;
  }

  .presentation-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .presentation-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.7rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 0.55rem;
    color: inherit;
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color 180ms ease,
      border-color 180ms ease;
  }

  .presentation-button:hover,
  .presentation-button:focus-visible {
    border-color: rgba(255, 255, 255, 0.9);
    background-color: rgba(255, 255, 255, 0.08);
  }

  .presentation-content {
    margin-top: 2rem;
    line-height: 1.75;
  }

  @media (max-width: 600px) {
    .presentation-details {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 420px) {
    .presentation-details {
      grid-template-columns: 1fr;
    }

    .presentation-links {
      display: grid;
    }
  }
</style>