---
import { getCollection, render } from "astro:content";
import PageLayout from "../../layouts/PageLayout.astro";

export async function getStaticPaths() {
  const observations = await getCollection("observations");

  return observations.map((observation) => ({
    params: {
      id: observation.id,
    },
    props: {
      observation,
    },
  }));
}

const { observation } = Astro.props;
const { Content } = await render(observation);

const formattedDate = observation.data.date.toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
});
---

<PageLayout
  title={observation.data.title}
  description={observation.data.summary}
>
  <section class="section section-alt">
    <article class="container observation">
      <header class="observation-header">
        <p class="observation-type">
          {observation.data.category}
        </p>

        <h1>{observation.data.title}</h1>

        <p class="observation-date">
          <time datetime={observation.data.date.toISOString()}>
            {formattedDate}
          </time>
        </p>

        <p class="observation-summary">
          {observation.data.summary}
        </p>
      </header>

      <div class="observation-body">
        <Content />
      </div>
    </article>
  </section>
</PageLayout>