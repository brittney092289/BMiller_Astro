---
import { getCollection } from "astro:content";
import PageLayout from "../../layouts/PageLayout.astro";
import ObservationCategoryCard from "../../components/ObservationCategoryCard.astro";
import { observationCategories } from "../../data/observationCategories";

const observations = await getCollection("observations");

const categories = observationCategories
  .map((category) => ({
    ...category,
    count: observations.filter(
      (observation) => observation.data.category === category.slug,
    ).length,
  }))
  .filter((category) => category.count > 0);
---

<PageLayout
  title="Observations"
  description="Astronomical observations, imaging notes, and observing records by Brittney Miller."
>

  <div class="category-grid">
    {
      categories.map((category) => (
        <ObservationCategoryCard
          label={category.label}
          description={category.description}
          href={`/observations/${category.slug}/`}
          image={category.image}
          count={category.count}
        />
      ))
    }
  </div>
</PageLayout>

<style>
  .intro {
    max-width: 42rem;
    margin-bottom: 4rem;
    color: rgba(255, 255, 255, 0.72);
    font-size: clamp(1.25rem, 2.5vw, 1.8rem);
    line-height: 1.55;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
  }

  @media (max-width: 760px) {
    .category-grid {
      grid-template-columns: 1fr;
    }
  }
</style>