---
import Layout from "../layouts/Layout.astro";
import CenterHero from "../components/CenterHero.astro";
import CornerNav from "../components/CornerNav.astro";
import SocialLinks from "../components/SocialLinks.astro";
---

<Layout title="Brittney Miller">
  <main class="home">
    <CenterHero />

    <CornerNav />

    <div class="homepage-socials">
      <SocialLinks />
    </div>
  </main>
</Layout>

<style>
  .home {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    background: #050505;
    color: #ffffff;
  }

  .homepage-socials {
    position: absolute;
    top: calc(50% + 6rem);
    left: 50%;
    z-index: 3;
    transform: translateX(-50%);
  }

  @media (max-width: 700px) {
    .home {
      display: flex;
      min-height: 100svh;
      overflow: visible;
      flex-direction: column;
    }

    .homepage-socials {
      position: static;
      display: flex;
      justify-content: center;
      margin: auto 0 2rem;
      padding: 2rem 1.5rem 0;
      transform: none;
    }
  }
</style>