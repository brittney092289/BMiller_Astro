---
import Layout from "../layouts/Layout.astro";
import CenterHero from "../components/CenterHero.astro";
import CornerNav from "../components/CornerNav.astro";
import cometImage from "../images/C_2025_A6_Lemmon_Mansfield_B4_102425_4.png";
---

<Layout
  title="Brittney Miller"
  description="Astronomical and Planetary Science student, amateur astronomer, astrophotographer, and front-end developer."
>
  <main
  class="home"
  style={`--home-image: url(${cometImage.src});`}
>
  <div class="home-background" aria-hidden="true"></div>
  <div class="home-overlay" aria-hidden="true"></div>

  <CenterHero />
  <CornerNav />
</main>
</Layout>

<style>
  .home {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    isolation: isolate;
    background: var(--bg);
  }

  .home-background,
  .home-overlay {
    position: absolute;
    inset: 0;
  }

  

  .home-background {
  background-image: var(--home-image);
  background-position: center;
  background-repeat: no-repeat;
  background-size: cover;
}

  .home-overlay {
    z-index: -1;
    background:
        linear-gradient(
        90deg,
        rgba(244, 243, 240, 0.94) 0%,
        rgba(244, 243, 240, 0.86) 24%,
        rgba(244, 243, 240, 0.58) 42%,
        rgba(244, 243, 240, 0.14) 58%,
        rgba(0, 0, 0, 0.03) 100%
        );
    }

  @media (max-width: 700px) {
    .home {
      display: flex;
      min-height: 100svh;
      overflow: visible;
      flex-direction: column;
      color: var(--text);
    }

    .home-background {
      position: fixed;
      background-position: 64% center;
    }

    .home-overlay {
      position: fixed;
      background:
        linear-gradient(
          180deg,
          rgba(5, 5, 5, 0.56) 0%,
          rgba(5, 5, 5, 0.82) 42%,
          rgba(5, 5, 5, 0.96) 100%
        );
    }
  }
</style>