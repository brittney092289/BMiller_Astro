---
import { getEntry } from "astro:content";

const siteEntry = await getEntry("site", "site-settings");

if (!siteEntry) {
    throw new Error("Site settings could not be loaded.");
}

const { socialLinks } = siteEntry.data;

const icons = {
    github: `
        <path d="M12 2C6.48 2 2 6.58 2 12.23c0 4.52 2.87 8.35 6.84 9.71.5.1.68-.22.68-.49 0-.24-.01-1.04-.02-1.89-2.78.62-3.37-1.21-3.37-1.21-.45-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.63.07-.63 1 .08 1.53 1.06 1.53 1.06.9 1.56 2.35 1.11 2.92.85.09-.66.35-1.11.64-1.37-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.31.1-2.72 0 0 .84-.28 2.75 1.05A9.3 9.3 0 0 1 12 6.96a9.3 9.3 0 0 1 2.5.35c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.46.1 2.72.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.79-4.57 5.05.36.32.68.95.68 1.92 0 1.39-.01 2.5-.01 2.84 0 .27.18.59.69.49A10.25 10.25 0 0 0 22 12.23C22 6.58 17.52 2 12 2Z"/>
    `,
    linkedin: `
        <path d="M6.5 8.5H3.2V21h3.3V8.5ZM4.85 3A1.91 1.91 0 1 0 4.85 6.82 1.91 1.91 0 0 0 4.85 3ZM21 13.8c0-3.77-2.01-5.52-4.69-5.52-2.16 0-3.13 1.19-3.67 2.03V8.5H9.35c.04 1.2 0 12.5 0 12.5h3.29v-6.98c0-.37.03-.75.14-1.02.24-.75.8-1.53 1.73-1.53 1.22 0 1.71.93 1.71 2.3V21H19.5v-7.2Z"/>
    `,
    instagram: `
        <path d="M7.5 2h9A5.5 5.5 0 0 1 22 7.5v9a5.5 5.5 0 0 1-5.5 5.5h-9A5.5 5.5 0 0 1 2 16.5v-9A5.5 5.5 0 0 1 7.5 2Zm0 2A3.5 3.5 0 0 0 4 7.5v9A3.5 3.5 0 0 0 7.5 20h9a3.5 3.5 0 0 0 3.5-3.5v-9A3.5 3.5 0 0 0 16.5 4h-9Zm9.75 1.5a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z"/>
    `,
    email: `
        <path d="M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm9 7 7.2-5H4.8L12 12Zm0 2.4L4 8.85V17h16V8.85L12 14.4Z"/>
    `,
};
---

<nav class="social-links" aria-label="Social links">
    <ul>
        {
            socialLinks.map(({ label, href, icon }) => {
                const isExternal = href.startsWith("http");

                return (
                    <li>
                        <a
                            href={href}
                            aria-label={label}
                            title={label}
                            target={isExternal ? "_blank" : undefined}
                            rel={isExternal ? "noopener noreferrer" : undefined}
                        >
                            <svg
                                viewBox="0 0 24 24"
                                aria-hidden="true"
                                focusable="false"
                            >
                                <Fragment set:html={icons[icon]} />
                            </svg>

                            <span class="label">{label}</span>
                        </a>
                    </li>
                );
            })
        }
    </ul>
</nav>

<style>
  .social-links ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .social-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 50%;
    color: rgba(255, 255, 255, 0.72);
    text-decoration: none;
    transition:
      color 180ms ease,
      border-color 180ms ease,
      background-color 180ms ease,
      transform 180ms ease;
  }

  .social-links a:hover,
  .social-links a:focus-visible {
    border-color: rgba(255, 255, 255, 0.7);
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    transform: translateY(-2px);
  }

  .social-links svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: currentColor;
  }

  .label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 700px) {
    .social-links ul {
  display: flex;
  justify-content: center;
  gap: .75rem;
}
  }

  @media (prefers-reduced-motion: reduce) {
    .social-links a {
      transition: none;
    }

    .social-links a:hover,
    .social-links a:focus-visible {
      transform: none;
    }
  }
</style>