---
const links = [
  {
    label: "About",
    href: "/about/",
    position: "top-left",
    side: "light",
  },
  {
    label: "Observations",
    href: "/observations/",
    position: "top-right",
    side: "dark",
  },
  {
    label: "Projects",
    href: "/projects/",
    position: "bottom-left",
    side: "light",
  },
  {
    label: "Outreach",
    href: "/outreach/",
    position: "bottom-right",
    side: "dark",
  },
];
---

<nav class="corner-nav" aria-label="Primary navigation">
  {
    links.map(({ label, href, position, side }) => (
      <a
        class={`corner-link ${position} ${side}`}
        href={href}
      >
        {label}
      </a>
    ))
  }
</nav>

<style>
  .corner-nav {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  .corner-link {
    position: absolute;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: clamp(1.25rem, 3vw, 2.5rem);
    font-size: clamp(1rem, 1.5vw, 1.35rem);
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      opacity 180ms ease,
      transform 180ms ease;
    pointer-events: auto;
  }

  .corner-link.light {
    color: rgba(17, 17, 17, 0.72);
  }

  .corner-link.dark {
    color: rgba(255, 255, 255, 0.82);
  }

  .corner-link:hover,
  .corner-link:focus-visible {
    opacity: 1;
  }

  .top-left {
    top: 0;
    left: 0;
  }

  .top-right {
    top: 0;
    right: 0;
  }

  .bottom-left {
    bottom: 0;
    left: 0;
  }

  .bottom-right {
    right: 0;
    bottom: 0;
  }

  @media (hover: hover) {
    .top-left:hover,
    .bottom-left:hover {
      transform: translateX(0.3rem);
    }

    .top-right:hover,
    .bottom-right:hover {
      transform: translateX(-0.3rem);
    }
  }

  @media (max-width: 700px) {
    .corner-nav {
      position: relative;
      inset: auto;
      z-index: 2;
      display: flex;
      order: 2;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.15rem;
      padding: 1rem 1.5rem 2rem;
    }

    .corner-link {
      position: static;
      padding: 0.1rem 0;
      color: transparent;
      font-size: clamp(3.5rem, 15vw, 6rem);
      font-weight: 600;
      letter-spacing: -0.06em;
      line-height: 0.98;
      text-transform: none;
      -webkit-text-stroke: 1px rgba(255, 255, 255, 0.82);
    }

    .corner-link.light,
    .corner-link.dark {
      color: transparent;
    }

    .corner-link:hover,
    .corner-link:focus-visible {
      color: #ffffff;
      -webkit-text-stroke-color: #ffffff;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .corner-link {
      transition: none;
    }
  }
</style>