---
const {
  title,
  date,
  venue,
  summary,
  href,
  location,
  audience,
  duration,
  attendance,
  recording,
} = Astro.props;

const formattedDate = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

function formatDuration(minutes = 0) {
  if (minutes < 60) {
    return `${minutes} min`;
  }

  const hours = Math.floor(minutes / 60);
  const remainingMinutes = minutes % 60;

  if (remainingMinutes === 0) {
    return `${hours} ${hours === 1 ? "hour" : "hours"}`;
  }

  return `${hours} hr ${remainingMinutes} min`;
}

const hasPresentationDetails =
  audience ||
  duration !== undefined ||
  attendance !== undefined;
---

<a class="talk-card" href={href}>
  <div class="talk-content">
    <div class="talk-meta">
      <time datetime={date.toISOString()}>
        {formattedDate}
      </time>

      <span aria-hidden="true">•</span>

      <span>{venue}</span>
    </div>

    <h3>{title}</h3>

    {
      location && (
        <p class="talk-location">{location}</p>
      )
    }

    <p class="talk-summary">{summary}</p>

    {
      hasPresentationDetails && (
        <div class="talk-details">
          {audience && <span>{audience}</span>}

          {
            duration !== undefined && (
              <span>{formatDuration(duration)}</span>
            )
          }

          {
            attendance !== undefined && (
              <span>
                {attendance.toLocaleString("en-US")}{" "}
                {attendance === 1 ? "attendee" : "attendees"}
              </span>
            )
          }
        </div>
      )
    }

    <div class="talk-footer">
      <span class="talk-link">
        View Presentation →
      </span>

      {
        recording && (
          <span class="recording-label">
            Recording available
          </span>
        )
      }
    </div>
  </div>
</a>

<style>
  .talk-card {
    display: block;
    height: 100%;
    overflow: hidden;
    border: 2px solid rgba(255, 255, 255, 0.5);
    border-radius: 0.9rem;
    background: rgb(16, 16, 16);
    color: inherit;
    text-decoration: none;
    transition:
      transform 250ms ease,
      border-color 250ms ease,
      box-shadow 250ms ease;
  }

  .talk-card:hover,
  .talk-card:focus-visible {
    transform: scale(1.01);
    border-color: rgba(255, 255, 255, 0.75);
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.08);
  }

  .talk-card:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  .talk-content {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding: 2rem;
  }

  .talk-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.5rem;
    margin-bottom: 0.75rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  h3 {
    margin: 0;
  }

  .talk-location {
    margin: 0.4rem 0 0;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .talk-summary {
    margin: 1rem 0 0;
    line-height: 1.6;
  }

  .talk-details {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1rem;
    margin-top: 1rem;
    color: var(--text-muted);
    font-size: 0.88rem;
  }

  .talk-details span {
    position: relative;
  }

  .talk-details span:not(:last-child)::after {
    content: "•";
    position: absolute;
    margin-left: 0.45rem;
  }

  .talk-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 1.25rem;
  }

  .talk-link {
    font-weight: 600;
  }

  .recording-label {
    color: var(--text-muted);
    font-size: 0.82rem;
  }

  @media (max-width: 500px) {
    .talk-content {
      padding: 1.5rem;
    }

    .talk-details {
      display: grid;
      gap: 0.35rem;
    }

    .talk-details span::after {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .talk-card {
      transition: none;
    }

    .talk-card:hover,
    .talk-card:focus-visible {
      transform: none;
    }
  }
</style>