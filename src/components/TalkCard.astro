---
const {
    title,
    date,
    venue,
    summary,
    href,
} = Astro.props;
---

<a class="talk-card" href={href}>

    <div class="talk-content">

        <div class="talk-meta">

            <span>{date}</span>

            <span>&bull;</span>

            <span>{venue}</span>

        </div>

        <h3>{title}</h3>

        <p>{summary}</p>

        <span class="talk-link">
            View Presentation →
        </span>

    </div>

</a>

<style>

.talk-card{
    padding:2rem;
    display: block;
    height: 100%;
    overflow: hidden;
    border: 2px solid rgba(255, 255, 255, 0.5);
    border-radius: 0.9rem;
    background: rgb(16, 16, 16);
    color: inherit;
    text-decoration: none;
    transition:
      transform 250ms ease,
      border-color 250ms ease,
      box-shadow 250ms ease;

}

.talk-card:hover{

    transform: scale(1.01);
    box-shadow:0 4px 8px rgba(0,0,0,.08);
    transition:
      transform 250ms ease,
      border-color 250ms ease,
      box-shadow 250ms ease;

}

.talk-meta{

    display:flex;

    gap:.5rem;

    color:var(--text-muted);

    font-size:.9rem;

    margin-bottom:.75rem;

}

.talk-link{

    display:inline-block;

    margin-top:1rem;

    font-weight:600;

}

</style>

<style>


  .image-wrapper {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #000000;
  }

  .image-wrapper :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease;
  }

  .card-content {
    padding: 1.5rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1rem;
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h2 {
    margin: 0;
    color: #ffffff;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    line-height: 1.1;
    letter-spacing: -0.035em;
  }

  .object {
    margin: 0.65rem 0 0;
    color: rgba(255, 255, 255, 0.65);
  }

  .summary {
    margin: 1.25rem 0 0;
    color: rgba(255, 255, 255, 0.62);
    line-height: 1.6;
  }

  a:hover,
  a:focus-visible {
    border-color: rgba(255, 255, 255, 0.4);
    /* transform: translateY(-0.2rem); */
  }

  a:hover .image-wrapper :global(img),
  a:focus-visible .image-wrapper :global(img) {
    transform: scale(1.035);
  }

  @media (prefers-reduced-motion: reduce) {
    a,
    .image-wrapper :global(img) {
      transition: none;
    }
  }
</style>