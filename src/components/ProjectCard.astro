---
import { Image } from "astro:assets";

interface Props {
  title: string;
  href: string;
  category: string;
  status: string;
  tags: string[];
  cover: ImageMetadata;
}

const {
  title,
  href,
  category,
  status,
  tags,
  cover,
} = Astro.props;
---

<article class="project-card">
  <a href={href}>
    <div class="project-image">
      <Image
        src={cover}
        alt={`Preview of ${title}`}
        widths={[600, 900, 1200]}
        sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 33vw"
        loading="lazy"
      />
    </div>

    <div class="project-info">
      <div class="project-heading">
        <div>
          <p class="meta">
            <span>{category}</span>
            <span aria-hidden="true">•</span>
            <span>{status}</span>
          </p>

          <h3>{title}</h3>
        </div>

        <span class="arrow" aria-hidden="true">↗</span>
      </div>

      <ul class="tags" aria-label="Project technologies">
        {tags.map((tag) => (
          <li>{tag}</li>
        ))}
      </ul>
    </div>
  </a>
</article>

<style>
  .project-card {
    flex: 1 1 calc(50% - 1rem);
    min-width: 18rem;
    max-width: calc(50% - 1rem);
  }

  .project-card a {
    display: block;
    height: 100%;
    overflow: hidden;

    border: 2px solid rgba(255, 255, 255, 0.5);
    border-radius: 0.9rem;

    background: rgb(16, 16, 16);
    color: inherit;
    text-decoration: none;

    transition:
      transform 250ms ease,
      border-color 250ms ease,
      box-shadow 250ms ease;
  }

  .project-image {
    position: relative;
    aspect-ratio: 16 / 7;
    overflow: hidden;

    background: #08090f;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .project-image :global(img) {
    display: block;
    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: center;

    transition: transform 400ms ease;
  }

  .project-info {
    padding: 1.25rem 1.4rem 1.4rem;
  }

  .project-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;

    margin: 0 0 0.7rem;

    color: rgba(255, 255, 255, 0.5);
    font-size: 0.68rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  h4 {
    margin: 0;

    font-size: clamp(1.25rem, 2vw, 1.7rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;

    margin: 1.15rem 0 0;
    padding: 0;

    list-style: none;
  }

  .tags li {
    padding: 0.3rem 0.65rem;

    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 999px;

    color: rgba(255, 255, 255, 0.68);
    font-size: 0.75rem;
  }

  .arrow {
    flex: 0 0 auto;

    color: rgba(255, 255, 255, 0.52);
    font-size: 1.35rem;

    transition:
      transform 250ms ease,
      color 250ms ease;
  }

  .project-card a:hover,
  .project-card a:focus-visible {
    border-color: rgba(255, 255, 255, 0.26);
    box-shadow: 0 1rem 2.5rem rgba(0, 0, 0, 0.22);
  }

  .project-card a:hover .project-image :global(img),
  .project-card a:focus-visible .project-image :global(img) {
    transform: scale(1.03);
  }

  .project-card a:hover .arrow,
  .project-card a:focus-visible .arrow {
    transform: translate(3px, -3px);
    color: #ffffff;
  }

  @media (max-width: 760px) {
    .project-card {
      flex-basis: 100%;
      min-width: 0;
      max-width: 100%;
    }

    .project-image {
      aspect-ratio: 16 / 8;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card a,
    .project-image :global(img),
    .arrow {
      transition: none;
    }
  }
</style>