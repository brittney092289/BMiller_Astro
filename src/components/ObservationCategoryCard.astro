---
import { Image } from "astro:assets";

interface Props {
  label: string;
  description: string;
  href: string;
  image: ImageMetadata;
  count: number;
}

const {
  label,
  description,
  href,
  image,
  count,
} = Astro.props;
---

<article class="category-card">
  <a href={href}>
    <Image
      src={image}
      alt={`${label} observations`}
      widths={[600, 900, 1200]}
      sizes="(max-width: 768px) 100vw, 50vw"
      loading="lazy"
      class="category-image"
    />

    <div class="overlay">
      <div>
        <p class="count">
          {count} {count === 1 ? "observation" : "observations"}
        </p>

        <h3>{label}</h3>
        <p class="description">{description}</p>
      </div>

      <span aria-hidden="true">↗</span>
    </div>
  </a>
</article>

<style>
  .category-card {
    min-width: 0;
  }

  a {
    position: relative;
    display: block;
    min-height: 24rem;
    overflow: hidden;
    text-decoration: none;
    height: 100%;
    border: 2px solid rgba(255, 255, 255, 0.5);
    border-radius: 0.9rem;
    background: rgb(16, 16, 16);
    color: inherit;
    transition:
      transform 250ms ease,
      border-color 250ms ease,
      box-shadow 250ms ease;
  }

  .category-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease;
  }

  .overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    padding: 2rem;
    background: linear-gradient(
      180deg,
      transparent 30%,
      rgba(0, 0, 0, 0.9) 100%
    );
  }

  .count {
    margin: 0 0 0.75rem;
    color: rgba(255, 255, 255, 0.58);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .description {
    max-width: 30rem;
    margin: 1rem 0 0;
    color: rgba(255, 255, 255, 0.68);
    line-height: 1.55;
  }

  span {
    flex: 0 0 auto;
    font-size: 1.5rem;
  }

  a:hover .category-image,
  a:focus-visible .category-image {
    transform: scale(1.035);
  }

  @media (prefers-reduced-motion: reduce) {
    .category-image {
      transition: none;
    }
  }
</style>