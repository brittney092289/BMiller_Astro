---
const { observation } = Astro.props;
---

<article>
  <h2>{observation.data.title}</h2>
  <p>{observation.data.description}</p>
  <p>{observation.data.date}</p>
  <p>{observation.data.location}</p>
</article>

<style>
.card {
  border-radius: 1rem;
  padding: 1.5rem;
  border: 1px solid #ddd;
}
</style>